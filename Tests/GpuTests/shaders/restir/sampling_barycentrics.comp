#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : require

#include "test_bindings.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer TestInput
{
    uvec4 seed;
    ivec4 params; // x = sample count
} in_data;

layout(std430, binding = 1) writeonly buffer TestOutput
{
    vec4 barycentrics[4096];
} out_data;

void main()
{
    uint seed  = in_data.seed.x;
    int  count = in_data.params.x;

    for ( int i = 0; i < count; ++i )
    {
        vec3 b = SampleTriangleBarycentrics( seed );
        out_data.barycentrics[i] = vec4( b, 0.0f );
    }
}
