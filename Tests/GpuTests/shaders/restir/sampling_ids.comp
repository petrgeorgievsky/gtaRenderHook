#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : require

#include "test_bindings.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer TestInput
{
    ivec4 params; // x = lightCountFull, y = sample count
    uvec4 seed;
} in_data;

layout(std430, binding = 1) writeonly buffer TestOutput
{
    int ids[4096];
} out_data;

void main()
{
    uint seed           = in_data.seed.x;
    int  lightCountFull = in_data.params.x;
    int  count          = in_data.params.y;

    for ( int i = 0; i < count; ++i )
        out_data.ids[i] = SampleLightId( seed, lightCountFull );
}
